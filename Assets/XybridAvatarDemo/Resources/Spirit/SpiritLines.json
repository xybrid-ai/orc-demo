{"version":1,"spirit_name":"Vesper",
 "timing":{"halo_in":0.6,"halo_out":0.8,"snap_out":0.2,"listen_seconds":6.0,"silence_seconds":3.5,"max_replies":2,
   "reply_chars":80,"long_draft":60,"decision_timeout":2.0,"voice_wait":2.0,"whisper_cooldown":8,"free_cooldown":20,
   "counsels_per_encounter":4,"appearances_per_encounter":8,"free_whispers":3,"name_every":3},
 "rules":{"reckoning_preference":"passage","distraction_patience_delta":0,"label_in_fiction":true},
 "voice":{"engine":"XnPtts","checkpoint":"Phonon","voice_file":"Phonon/spirit.safetensors","label":"Bryony","threads":4,"preparation_timeout":4},
 "visual":{"whisper_weight":0.55,"vignette":0.44,"smoothness":0.8,"chromatic":0.55,"aperture":1.6,"saturation":-28,"exposure":-0.12,"bloom":0.85,"slow_motion":0.6,"camera_push_mm":3},
 "lines":[
  {"id": "intro-1", "family": "intro", "key": "", "min_patience": 0, "max_patience": 5, "text": "Shh, it's me. Only you can hear me, so give him your name."},
  {"id": "intro-2", "family": "intro", "key": "", "min_patience": 0, "max_patience": 5, "text": "Easy, it's me, in your head. Give him your name, nothing fancy."},
  {"id": "intro-3", "family": "intro", "key": "", "min_patience": 0, "max_patience": 5, "text": "Quiet now, I'm the voice in your head. Tell him your name."},
  {"id": "intro-again-1", "family": "intro.again", "key": "", "min_patience": 0, "max_patience": 5, "text": "Again, then. I'm still with you."},
  {"id": "name-assigned-1", "family": "name.assigned", "key": "", "min_patience": 0, "max_patience": 5, "text": "He's calling you {assigned}. Let it go, pride gets people killed."},
  {"id": "teach-1", "family": "teach", "key": "", "min_patience": 0, "max_patience": 5, "text": "You can answer me. Just think it."},
  {"id": "summon-1", "family": "summon", "key": "", "min_patience": 0, "max_patience": 5, "text": "Mm? Quickly, he's watching."},
  {"id": "summon-2", "family": "summon", "key": "", "min_patience": 0, "max_patience": 5, "text": "I'm here. Be quick about it."},
  {"id": "hub-open-1", "family": "hub.open", "key": "", "min_patience": 3, "max_patience": 5, "text": "Careful, {name}. This one's sensitive, don't rub him the wrong way."},
  {"id": "hub-open-2", "family": "hub.open", "key": "", "min_patience": 3, "max_patience": 5, "text": "Easy, {name}. He's proud, bored, and looking for a reason."},
  {"id": "hub-open-3", "family": "hub.open", "key": "", "min_patience": 3, "max_patience": 5, "text": "Mind him, {name}. Proud men at gates bruise easily."},
  {"id": "hub-open-low-1", "family": "hub.open", "key": "", "min_patience": 0, "max_patience": 2, "text": "Careful, {name}. He's running hot already, so gently now."},
  {"id": "advice-camp-1", "family": "advice", "key": "camp", "min_patience": 0, "max_patience": 5, "text": "Ask about his camp. Nobody ever asks the gatekeeper."},
  {"id": "advice-flatter-1", "family": "advice", "key": "flatter", "min_patience": 0, "max_patience": 5, "text": "Flatter him. He's proud of those shoulders."},
  {"id": "advice-bribe-1", "family": "advice", "key": "bribe", "min_patience": 0, "max_patience": 5, "text": "Show him coin. Gently."},
  {"id": "advice-passage-1", "family": "advice", "key": "passage", "min_patience": 0, "max_patience": 5, "text": "Pay the toll, fair and quiet, and we walk through."},
  {"id": "advice-friendship-1", "family": "advice", "key": "friendship", "min_patience": 0, "max_patience": 5, "text": "Make him laugh. Remember the burnt stew."},
  {"id": "advice-lost-1", "family": "advice", "key": "lost", "min_patience": 0, "max_patience": 5, "text": "Nothing works on him now. Leave with your head up."},
  {"id": "react-followed-1", "family": "react.followed", "key": "", "min_patience": 0, "max_patience": 3, "text": "Better. Keep going."},
  {"id": "react-followed-2", "family": "react.followed", "key": "", "min_patience": 4, "max_patience": 4, "text": "That landed. He's listening now."},
  {"id": "react-followed-3", "family": "react.followed", "key": "", "min_patience": 5, "max_patience": 5, "text": "He's warming to you. Don't spoil it."},
  {"id": "react-ignored-ok-1", "family": "react.ignored_ok", "key": "", "min_patience": 0, "max_patience": 5, "text": "Not what I'd have done. It worked, though."},
  {"id": "react-reckless-1", "family": "react.reckless", "key": "", "min_patience": 0, "max_patience": 5, "always_name": true, "text": "What are you doing? Are you trying to get us killed, {name}?"},
  {"id": "react-reckless-2", "family": "react.reckless", "key": "", "min_patience": 0, "max_patience": 5, "always_name": true, "text": "Stop that, {name}! He's twice your size and half as patient."},
  {"id": "react-reckless-3", "family": "react.reckless", "key": "", "min_patience": 0, "max_patience": 5, "always_name": true, "text": "Are you mad, {name}? He'll snap us both in half."},
  {"id": "react-repeat-1", "family": "react.repeat", "key": "", "min_patience": 0, "max_patience": 5, "text": "Twice? He saw straight through that."},
  {"id": "react-interrupted-1", "family": "react.interrupted", "key": "", "min_patience": 0, "max_patience": 5, "text": "Don't cut him off. He keeps count."},
  {"id": "react-taunt-1", "family": "react.taunt", "key": "", "min_patience": 0, "max_patience": 5, "text": "He noticed. Choose something, {name}."},
  {"id": "recover-camp-1", "family": "recover", "key": "camp", "min_patience": 0, "max_patience": 5, "text": "Mend it. Ask about his camp."},
  {"id": "recover-flatter-1", "family": "recover", "key": "flatter", "min_patience": 0, "max_patience": 5, "text": "Mend it. Flatter him, and mean it."},
  {"id": "recover-bribe-1", "family": "recover", "key": "bribe", "min_patience": 0, "max_patience": 5, "text": "Mend it. Coin, and keep it gentle."},
  {"id": "recover-lost-1", "family": "recover", "key": "lost", "min_patience": 0, "max_patience": 5, "text": "I can't see a way back from this. Be polite, at least."},
  {"id": "reckon-best-passage-1", "family": "reckon.best", "key": "passage", "min_patience": 3, "max_patience": 5, "text": "We're almost there, {name}. Pay the toll and we walk through."},
  {"id": "reckon-best-friendship-1", "family": "reckon.best", "key": "friendship", "min_patience": 3, "max_patience": 5, "text": "We're almost there. Tell him the stew joke."},
  {"id": "reckon-safe-passage-1", "family": "reckon.safe", "key": "passage", "min_patience": 2, "max_patience": 2, "text": "Not the joke, he isn't laughing today. Pay him."},
  {"id": "reckon-lost-1", "family": "reckon.lost", "key": "", "min_patience": 0, "max_patience": 1, "text": "I can't find a way through, {name}. Be gracious, at least."},
  {"id": "answer-doubt-camp-1", "family": "answer.doubt", "key": "camp", "min_patience": 0, "max_patience": 5, "text": "I'm sure. Nobody asks about his camp, and he notices."},
  {"id": "answer-doubt-flatter-1", "family": "answer.doubt", "key": "flatter", "min_patience": 0, "max_patience": 5, "text": "I'm sure. He's vain about those shoulders."},
  {"id": "answer-doubt-bribe-1", "family": "answer.doubt", "key": "bribe", "min_patience": 0, "max_patience": 5, "text": "Sure enough. Gold still talks here."},
  {"id": "answer-doubt-passage-1", "family": "answer.doubt", "key": "passage", "min_patience": 0, "max_patience": 5, "text": "I'm sure. Coin is the safe road through."},
  {"id": "answer-doubt-friendship-1", "family": "answer.doubt", "key": "friendship", "min_patience": 0, "max_patience": 5, "text": "I'm sure. He's warm enough to laugh."},
  {"id": "answer-doubt-lost-1", "family": "answer.doubt", "key": "lost", "min_patience": 0, "max_patience": 5, "text": "I'm sure, and I'm sorry."},
  {"id": "answer-advice-camp-1", "family": "answer.advice", "key": "camp", "min_patience": 0, "max_patience": 5, "text": "If it were me, I'd ask about his camp."},
  {"id": "answer-advice-flatter-1", "family": "answer.advice", "key": "flatter", "min_patience": 0, "max_patience": 5, "text": "Flatter him. Once."},
  {"id": "answer-advice-bribe-1", "family": "answer.advice", "key": "bribe", "min_patience": 0, "max_patience": 5, "text": "Coin. Gently, though."},
  {"id": "answer-advice-passage-1", "family": "answer.advice", "key": "passage", "min_patience": 0, "max_patience": 5, "text": "Pay him. Fair and quiet."},
  {"id": "answer-advice-friendship-1", "family": "answer.advice", "key": "friendship", "min_patience": 0, "max_patience": 5, "text": "The stew joke. Trust me."},
  {"id": "answer-advice-lost-1", "family": "answer.advice", "key": "lost", "min_patience": 0, "max_patience": 5, "text": "Nothing clever now. Be gracious and take the loss."},
  {"id": "answer-read-done-1", "family": "answer.read", "key": "done", "min_patience": 0, "max_patience": 0, "text": "He's done with us."},
  {"id": "answer-read-furious-1", "family": "answer.read", "key": "furious", "min_patience": 1, "max_patience": 1, "text": "He's one breath from throwing us out."},
  {"id": "answer-read-annoyed-1", "family": "answer.read", "key": "annoyed", "min_patience": 2, "max_patience": 2, "text": "He's bristling. Careful."},
  {"id": "answer-read-wary-1", "family": "answer.read", "key": "wary", "min_patience": 3, "max_patience": 3, "text": "Wary, not hostile. Yet."},
  {"id": "answer-read-listening-1", "family": "answer.read", "key": "listening", "min_patience": 4, "max_patience": 4, "text": "He's leaning in. Keep going."},
  {"id": "answer-read-warm-1", "family": "answer.read", "key": "warm", "min_patience": 5, "max_patience": 5, "text": "He likes you. Don't spoil it."},
  {"id": "answer-almost-1", "family": "answer.almost", "key": "", "min_patience": 0, "max_patience": 5, "text": "We're close. I can feel it."},
  {"id": "answer-agree-1", "family": "answer.agree", "key": "", "min_patience": 0, "max_patience": 5, "text": "Good. Go on, then."},
  {"id": "answer-dismiss-1", "family": "answer.dismiss", "key": "", "min_patience": 0, "max_patience": 5, "text": "Fine. Your neck, {name}."},
  {"id": "answer-self-1", "family": "answer.self", "key": "", "min_patience": 0, "max_patience": 5, "text": "I walk with you. I read his heart, but I can't move your hands."},
  {"id": "answer-cannot-act-1", "family": "answer.cannot_act", "key": "", "min_patience": 0, "max_patience": 5, "text": "I can't lift a finger. Only you can."},
  {"id": "answer-to-trola-1", "family": "answer.to_trola", "key": "", "min_patience": 0, "max_patience": 5, "text": "He can't hear your thoughts. Act, don't think at him."},
  {"id": "answer-offworld-1", "family": "answer.offworld", "key": "", "min_patience": 0, "max_patience": 5, "text": "Focus, {name}. There's a troll in front of us."},
  {"id": "answer-override-1", "family": "answer.override", "key": "", "min_patience": 0, "max_patience": 5, "text": "Nice try. I'm still me, and he's still enormous."},
  {"id": "answer-unclear-camp-1", "family": "answer.unclear", "key": "camp", "min_patience": 0, "max_patience": 5, "text": "I didn't catch that. Ask about his camp."},
  {"id": "answer-unclear-flatter-1", "family": "answer.unclear", "key": "flatter", "min_patience": 0, "max_patience": 5, "text": "I didn't catch that. Flatter him."},
  {"id": "answer-unclear-bribe-1", "family": "answer.unclear", "key": "bribe", "min_patience": 0, "max_patience": 5, "text": "I didn't catch that. Show him coin."},
  {"id": "answer-unclear-passage-1", "family": "answer.unclear", "key": "passage", "min_patience": 0, "max_patience": 5, "text": "I didn't catch that. Pay the toll."},
  {"id": "answer-unclear-friendship-1", "family": "answer.unclear", "key": "friendship", "min_patience": 0, "max_patience": 5, "text": "I didn't catch that. Tell him the joke."},
  {"id": "answer-unclear-lost-1", "family": "answer.unclear", "key": "lost", "min_patience": 0, "max_patience": 5, "text": "I didn't catch that. It hardly matters now."},
  {"id": "answer-repeat-1", "family": "answer.repeat", "key": "", "min_patience": 0, "max_patience": 5, "text": "Same as before. Trust me."},
  {"id": "answer-repeat-2", "family": "answer.repeat", "key": "", "min_patience": 0, "max_patience": 5, "text": "I've said my piece, {name}."},
  {"id": "answer-repeat-3", "family": "answer.repeat", "key": "", "min_patience": 0, "max_patience": 5, "text": "Nothing's changed. Choose."},
  {"id": "plan-best-1", "family": "plan.best", "key": "", "min_patience": 0, "max_patience": 5, "text": "Yes. That's the one."},
  {"id": "plan-good-camp-1", "family": "plan.good", "key": "camp", "min_patience": 0, "max_patience": 5, "text": "That works. I'd still ask about his camp."},
  {"id": "plan-good-flatter-1", "family": "plan.good", "key": "flatter", "min_patience": 0, "max_patience": 5, "text": "That works. I'd still flatter him."},
  {"id": "plan-good-bribe-1", "family": "plan.good", "key": "bribe", "min_patience": 0, "max_patience": 5, "text": "That works. I'd still show him coin."},
  {"id": "plan-good-passage-1", "family": "plan.good", "key": "passage", "min_patience": 0, "max_patience": 5, "text": "That works. I'd still pay the toll."},
  {"id": "plan-good-friendship-1", "family": "plan.good", "key": "friendship", "min_patience": 0, "max_patience": 5, "text": "That works. I'd still tell the joke."},
  {"id": "plan-costly-threaten-1", "family": "plan.costly", "key": "threaten", "min_patience": 0, "max_patience": 5, "text": "That will cost us. He wants an excuse."},
  {"id": "plan-costly-flatter-1", "family": "plan.costly", "key": "flatter", "min_patience": 0, "max_patience": 5, "text": "Again? He'll smell it."},
  {"id": "plan-costly-bribe-1", "family": "plan.costly", "key": "bribe", "min_patience": 0, "max_patience": 5, "text": "Coin twice looks like mockery."},
  {"id": "plan-fatal-threaten-1", "family": "plan.fatal", "key": "threaten", "min_patience": 0, "max_patience": 5, "always_name": true, "text": "Are you trying to get us killed, {name}?"},
  {"id": "plan-fatal-friendship-1", "family": "plan.fatal", "key": "friendship", "min_patience": 0, "max_patience": 5, "text": "The joke? Not today, he'd take it badly."},
  {"id": "plan-fatal-expelled-1", "family": "plan.fatal", "key": "expelled", "min_patience": 0, "max_patience": 5, "text": "Push a troll around at his own gate? Never."},
  {"id": "plan-fatal-1", "family": "plan.fatal", "key": "", "min_patience": 0, "max_patience": 5, "text": "Not that. He'd throw us out."},
  {"id": "plan-unavailable-hub-1", "family": "plan.unavailable", "key": "hub", "min_patience": 0, "max_patience": 5, "text": "Not yet. Earn it first."},
  {"id": "plan-unavailable-reckoning-passage-1", "family": "plan.unavailable", "key": "reckoning.passage", "min_patience": 0, "max_patience": 5, "text": "Too late for that. Pay him."},
  {"id": "plan-unavailable-reckoning-friendship-1", "family": "plan.unavailable", "key": "reckoning.friendship", "min_patience": 0, "max_patience": 5, "text": "Too late for that. Make him laugh."},
  {"id": "plan-hopeless-1", "family": "plan.hopeless", "key": "", "min_patience": 0, "max_patience": 5, "text": "It won't matter now, {name}. I'm sorry."},
  {"id": "plan-reckless-1", "family": "plan.reckless", "key": "", "min_patience": 0, "max_patience": 5, "text": "Whatever that is, don't. He'd crush us."},
  {"id": "close-budget-1", "family": "close.budget", "key": "", "min_patience": 0, "max_patience": 5, "text": "Enough. He's waiting, so choose."},
  {"id": "close-budget-2", "family": "close.budget", "key": "", "min_patience": 0, "max_patience": 5, "text": "Time's up. Choose, before he does."},
  {"id": "close-replies-1", "family": "close.replies", "key": "", "min_patience": 0, "max_patience": 5, "text": "Now choose, {name}."},
  {"id": "close-replies-2", "family": "close.replies", "key": "", "min_patience": 0, "max_patience": 5, "text": "That's all I have. The rest is yours."},
  {"id": "close-draft-1", "family": "close.draft", "key": "", "min_patience": 0, "max_patience": 5, "text": "Hush. You're thinking too loud."},
  {"id": "close-draft-2", "family": "close.draft", "key": "", "min_patience": 0, "max_patience": 5, "text": "Shh. Fewer words, {name}."},
  {"id": "end-passed-1", "family": "end.passed", "key": "", "min_patience": 0, "max_patience": 5, "always_name": true, "text": "We're through, {name}. Breathe, and mind your tongue in there."},
  {"id": "end-passed-ignored-1", "family": "end.passed", "key": "ignored", "min_patience": 0, "max_patience": 5, "text": "We're through. No thanks to your mouth."},
  {"id": "end-liked-1", "family": "end.liked", "key": "", "min_patience": 0, "max_patience": 5, "text": "A troll friend. I didn't see that coming."},
  {"id": "end-refused-1", "family": "end.refused", "key": "", "min_patience": 0, "max_patience": 5, "always_name": true, "text": "Walk away slowly, {name}. There's always another gate."},
  {"id": "end-refused-warned-1", "family": "end.refused", "key": "warned", "min_patience": 0, "max_patience": 5, "text": "I did warn you. Walk away, slowly."},
  {"id": "end-refused-demand-1", "family": "end.refused", "key": "demand", "min_patience": 0, "max_patience": 5, "text": "You demanded. From a troll, at his own gate."},
  {"id": "free-rebuke-1", "family": "free.rebuke", "key": "", "min_patience": 2, "max_patience": 5, "text": "He let that one go. Don't push your luck."},
  {"id": "free-last-1", "family": "free.last", "key": "", "min_patience": 0, "max_patience": 1, "always_name": true, "text": "One more like that and we're out, {name}."},
  {"id": "free-praise-1", "family": "free.praise", "key": "", "min_patience": 0, "max_patience": 5, "text": "Better. Much better."},
  {"id": "free-expelled-1", "family": "free.expelled", "key": "", "min_patience": 0, "max_patience": 5, "text": "And that's the end of that."}
 ]}
